# SmileX-Admin-Gin Docker 部署环境变量模板
# 用法：cp .env.example .env 后按需修改；docker compose 自动读取同目录 .env

# ---- 对外端口 ----
APP_PORT=8080

# ---- 数据库驱动：mysql | postgres | sqlite（默认 mysql）----
DB_DRIVER=mysql

# ---- MySQL（compose 自带 mysql 服务）----
MYSQL_ROOT_PASSWORD=change-me-root
MYSQL_DATABASE=smilex_admin_gin
MYSQL_USER=smilex
MYSQL_PASSWORD=change-me

# ---- Postgres（仅 DB_DRIVER=postgres 时需要，配合放开 compose 中 postgres 服务）----
POSTGRES_USER=smilex
POSTGRES_PASSWORD=change-me
POSTGRES_DB=smilex_admin_gin

# ---- Redis（默认空密码；如需密码须同步修改 redis 服务 command）----
REDIS_PASSWORD=

# ---- JWT 签名密钥：必改！生成方式 openssl rand -base64 32 ----
# 更换后所有已签发 token 失效，全部用户需重新登录
JWT_SECRET=

# ---- 首次播种超管初始密码：留空则随机生成并在启动日志打印一次 ----
SEED_ADMIN_PASSWORD=
